
@startuml

skinparam backgroundColor #F5F8FF
skinparam shadowing false
skinparam roundcorner 12
skinparam sequenceArrowColor #2563EB
skinparam sequenceLifeLineBorderColor #C8DBFC
skinparam sequenceParticipantBackgroundColor #DFEAFE
skinparam sequenceParticipantBorderColor #DFEAFE
skinparam sequenceParticipantFontColor #183154
skinparam sequenceParticipantFontStyle bold
skinparam sequenceGroupBackgroundColor #EFF5FF
skinparam sequenceGroupBorderColor #9EC4FF

hide footbox

participant Jugador
participant VistaMisiones
participant MisionService #2563EB
participant Personaje
participant MisionRepository #2563EB

Jugador -> VistaMisiones: selecciona completar
VistaMisiones -> MisionService: completarMision(...)

MisionService -> MisionRepository: obtenerPorId(id)
MisionRepository -> MisionService: misión

MisionService -> Personaje: ganarExperiencia(exp)

alt exp. suficiente
    MisionService -> Personaje: subirNivel()
end

MisionService -> MisionRepository: guardarProgreso(...)
MisionService -> MisionRepository: marcarCompletada(...)

MisionService -> VistaMisiones: resultado
VistaMisiones -> Jugador: confirmación

@enduml
